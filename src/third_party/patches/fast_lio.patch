diff --git a/src/preprocess.h b/src/preprocess.h
index d4d6ddc..a762fd4 100644
--- a/src/preprocess.h
+++ b/src/preprocess.h
@@ -151,6 +151,17 @@ class Preprocess
   float time_unit_scale;
   int lidar_type, point_filter_num, N_SCANS, SCAN_RATE, time_unit;
   double blind;
+  // Quader im Lidar-Frame, deren Punkte verworfen werden (Roboterkörper, Mast): je Quader
+  // xmin, xmax, ymin, ymax, zmin, zmax [m], hintereinander (Länge ein Vielfaches von 6)
+  std::vector<double> exclude_boxes;
+  bool excluded(float x, float y, float z) const
+  {
+    for (size_t k = 0; k + 5 < exclude_boxes.size(); k += 6)
+      if (x >= exclude_boxes[k] && x <= exclude_boxes[k + 1] && y >= exclude_boxes[k + 2] &&
+          y <= exclude_boxes[k + 3] && z >= exclude_boxes[k + 4] && z <= exclude_boxes[k + 5])
+        return true;
+    return false;
+  }
   bool feature_enabled, given_offset_time;
