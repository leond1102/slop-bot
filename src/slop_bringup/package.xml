<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slop_bringup</name>
  <version>0.1.0</version>
  <description>Slop-Bot Plattform starten: Antrieb, Sicherheit, Robotermodell und EKF in einer Launch-Datei</description>
  <maintainer email="leodresel11@gmail.com">Leon</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>slop_base</exec_depend>
  <exec_depend>slop_safety</exec_depend>
  <exec_depend>slop_description</exec_depend>
  <exec_depend>slop_localization</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
