Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Tree Height: 400
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Plane Cell Count: 20
      Cell Size: 0.5
      Color: 160; 160; 164
      Alpha: 0.4
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Livox Mid-360s
      Enabled: true
      Topic:
        Value: /livox/lidar
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Decay Time: 0
      Alpha: 1
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: RealSense Punktwolke
      Enabled: true
      Topic:
        Value: /camera/depth/color/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Decay Time: 0
      Alpha: 1
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Farbbild
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Tiefenbild
      Enabled: true
      Topic:
        Value: /camera/depth/image_rect_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: false
      Min Value: 0
      Max Value: 5
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_footprint
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 3.6
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Width: 1600
  Height: 950
  Displays:
    collapsed: false
  Views:
    collapsed: true
