Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 400
  - Class: rviz_common/Views
    Name: Views
  # Bedienfeld von slam_toolbox: Karte speichern (Save Map), Posegraph speichern (Serialize Map) u. a.
  - Class: slam_toolbox::SlamToolboxPlugin
    Name: SlamToolboxPlugin
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Alpha: 0.3
    # Karte von slam_toolbox (weiß = frei, schwarz = belegt, grau = unbekannt)
    - Class: rviz_default_plugins/Map
      Name: Karte (/map)
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.8
      Draw Behind: true
    - Class: rviz_default_plugins/RobotModel
      Name: Roboter
      Enabled: true
      Description Topic:
        Value: /robot_description
    # Aktueller 2D-Scan (rot): muss auf den Wänden der Karte liegen
    - Class: rviz_default_plugins/LaserScan
      Name: Laserscan (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.04
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Use Fixed Frame: true
    # Posegraph von slam_toolbox (Knoten = gespeicherte Scans, Kanten = Abgleiche/Schleifenschlüsse)
    - Class: rviz_default_plugins/MarkerArray
      Name: Posegraph
      Enabled: true
      Topic:
        Value: /slam_toolbox/graph_visualization
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.3
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
      X: 0
      Y: 0
