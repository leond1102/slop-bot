Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Name: Roboter
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.2
    # Aus den Scans geschnittene Quader (lio_bridge, lio.launch.py crop:=true): orange = Körper, rot = hinter dem Lidar.
    # Alles darin sieht FAST-LIO nicht.
    - Class: rviz_default_plugins/MarkerArray
      Name: Ausschnitt (Quader)
      Enabled: true
      Topic:
        Value: /lio/crop_boxes
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    # Registrierte Wolke von FAST-LIO im Weltframe: braucht lio.launch.py clouds:=true. Decay Time baut den Raum beim Fahren auf.
    - Class: rviz_default_plugins/PointCloud2
      Name: LIO-Wolke (/cloud_registered)
      Enabled: true
      Topic:
        Value: /cloud_registered
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.03
      Decay Time: 5
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Use rainbow: true
    # Pose von LIO (grün) und des EKF aus Rädern, Gyro und LIO-Geschwindigkeit (gelb) im Vergleich
    - Class: rviz_default_plugins/Odometry
      Name: LIO-Pose (/lio/odom)
      Enabled: true
      Topic:
        Value: /lio/odom
        Reliability Policy: Best Effort
      Keep: 300
      Shape:
        Value: Arrow
        Alpha: 1
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.1
        Shaft Radius: 0.025
        Color: 0; 200; 0
      Covariance:
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
          Value: false
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Scale: 1
          Value: false
        Value: false
    - Class: rviz_default_plugins/Odometry
      Name: EKF (/odom)
      Enabled: true
      Topic:
        Value: /odom
        Reliability Policy: Best Effort
      Keep: 300
      Shape:
        Value: Arrow
        Alpha: 1
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.1
        Shaft Radius: 0.025
        Color: 255; 255; 0
      Covariance:
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
          Value: false
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Scale: 1
          Value: false
        Value: false
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 3.3
