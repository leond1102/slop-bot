Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 420
  - Class: rviz_common/Views
    Name: Views
  # Nav2-Bedienfeld: Status, Ziel abbrechen, Wegpunkte
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Alpha: 0.2
    - Class: rviz_default_plugins/Map
      Name: Karte (/map)
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: true
    # Globale Costmap (Karte + Sensoren + Sicherheitsabstand), Grundlage für den Planer
    - Class: rviz_default_plugins/Map
      Name: Globale Costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.3
      Draw Behind: false
    # Erfahrungskarte (slop_navigation/experience): Beständigkeit je Zelle, weiß = immer frei, grau = mal belegt
    # (Stuhl), schwarz = fest (Wand, Tisch); ohne Meinung wie „unbekannt“. Standard aus, in der Liste einschalten.
    - Class: rviz_default_plugins/Map
      Name: Erfahrung (Beständigkeit)
      Enabled: false
      Topic:
        Value: /experience/persistence
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: false
    # Lokale Costmap (4 × 4 m um den Roboter, nur Sensoren), Grundlage für den Controller
    - Class: rviz_default_plugins/Map
      Name: Lokale Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.5
      Draw Behind: false
    - Class: rviz_default_plugins/RobotModel
      Name: Roboter
      Enabled: true
      Description Topic:
        Value: /robot_description
    # Footprint, wie Nav2 ihn nutzt (grün)
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Reliability Policy: Reliable
      Color: 0; 200; 0
      Alpha: 1
    # Collision Monitor: Stopp-Zone (rot) und Langsam-Zone (gelb)
    - Class: rviz_default_plugins/Polygon
      Name: Stopp-Zone
      Enabled: true
      Topic:
        Value: /polygon_stop
        Depth: 5
        Reliability Policy: Best Effort
      Color: 255; 0; 0
      Alpha: 1
    - Class: rviz_default_plugins/Polygon
      Name: Langsam-Zone
      Enabled: true
      Topic:
        Value: /polygon_slowdown
        Depth: 5
        Reliability Policy: Best Effort
      Color: 255; 200; 0
      Alpha: 1
    # Geplanter Weg (blau) und Ausschnitt des Controllers
    - Class: rviz_default_plugins/Path
      Name: Plan (/plan)
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        Reliability Policy: Reliable
      Color: 0; 120; 255
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: Controller-Plan
      Enabled: true
      Topic:
        Value: /received_global_plan
        Depth: 5
        Reliability Policy: Reliable
      Color: 255; 0; 255
      Line Style: Lines
    - Class: rviz_default_plugins/PointStamped
      Name: Zielpunkt Controller
      Enabled: true
      Topic:
        Value: /lookahead_point
        Depth: 5
        Reliability Policy: Reliable
      Color: 255; 0; 255
      Radius: 0.05
    - Class: rviz_default_plugins/LaserScan
      Name: Laserscan (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.04
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Kamera-Hindernisse
      Enabled: true
      Topic:
        Value: /camera/obstacles
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Boxes
      Size (m): 0.05
      Alpha: 0.9
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 120; 0
      Use Fixed Frame: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL-Partikel
      Enabled: false
      Topic:
        Value: /particle_cloud
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Color: 0; 180; 255
      Shape: Arrow (Flat)
      Arrow Length: 0.15
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    # "Nav2 Goal": Ziel setzen (Pfeil an die Stelle und in Zielrichtung ziehen)
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
      X: 0
      Y: 0
