Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 450
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Alpha: 0.3
    # Gespeicherte Karte (map_server)
    - Class: rviz_default_plugins/Map
      Name: Karte (/map)
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.8
      Draw Behind: true
    - Class: rviz_default_plugins/RobotModel
      Name: Roboter
      Enabled: true
      Description Topic:
        Value: /robot_description
    # Aktueller Scan (rot): liegt er auf den Wänden der Karte, stimmt die Lokalisierung
    - Class: rviz_default_plugins/LaserScan
      Name: Laserscan (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.05
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Use Fixed Frame: true
    # Partikel von AMCL: eng beisammen = sicher, verstreut = unsicher
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL-Partikel
      Enabled: true
      Topic:
        Value: /particle_cloud
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Color: 0; 180; 255
      Shape: Arrow (Flat)
      Arrow Length: 0.15
    # Geschätzte Pose mit Unsicherheit (Ellipse)
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL-Pose (/amcl_pose)
      Enabled: true
      Topic:
        Value: /amcl_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 255; 200; 0
      Covariance:
        Value: true
        Position:
          Value: true
          Color: 204; 51; 204
          Alpha: 0.3
          Scale: 1
        Orientation:
          Value: true
          Color: 255; 255; 127
          Alpha: 0.5
          Scale: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.3
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    # "2D Pose Estimate": Startpose für AMCL setzen (Pfeil an die Stelle und in Blickrichtung ziehen)
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
      X: 0
      Y: 0
