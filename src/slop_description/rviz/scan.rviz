Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Name: Roboter
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.2
    # Aus Wolke und Scan geschnittene Quader (lio_bridge): orange = Körper, rot = hinter dem Lidar
    - Class: rviz_default_plugins/MarkerArray
      Name: Ausschnitt (Quader)
      Enabled: true
      Topic:
        Value: /lio/crop_boxes
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    # Lidar-Wolke ohne Roboter (livox_to_cloud), nach Höhe eingefärbt. Daraus entsteht der Scan.
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar-Wolke (/livox/points)
      Enabled: true
      Topic:
        Value: /livox/points
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Alpha: 0.6
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Use rainbow: true
    # 2D-Scan (pointcloud_to_laserscan): Höhenband 0,15–1,80 m über dem Boden, als rote Punkte in der Bodenebene
    - Class: rviz_default_plugins/LaserScan
      Name: Laserscan (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.05
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Use Fixed Frame: true
  Global Options:
    # Roboterfest: braucht nur das Modell (Bringup oder description.launch.py), kein EKF und kein LIO-map
    Fixed Frame: base_footprint
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 3.3
