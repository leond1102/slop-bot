<?xml version="1.0"?>
<!-- Slop-Bot: Differentialantrieb, Livox Mid-360s und RealSense D435i.
     Koordinaten (ROS): x vorne, y links, z oben.

     TF-Baum:  odom → base_footprint (diff_drive_node) → base_link → Räder / Schleppräder / livox_frame / camera_link
       base_footprint  Boden unter der Mitte der Antriebsachse
       base_link       Drehpunkt = Mitte der Antriebsachse (Radmitte, wheel_radius über dem Boden)
     Die Sensor-Unterframes der RealSense (camera_depth_frame, camera_imu_optical_frame ...) sendet der Treiber
     selbst (publish_tf in slop_sensors/config/realsense.yaml); hier endet das Modell bei camera_link. -->
<robot name="slop_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Radmaße, Spur und Gelenknamen stehen nur in diff_drive.yaml -->
  <xacro:property name="drive" value="${xacro.load_yaml('$(find slop_base)/config/diff_drive.yaml')['diff_drive_node']['ros__parameters']}"/>
  <xacro:property name="wheel_radius" value="${drive['wheel_diameter'] / 2.0}"/>
  <xacro:property name="track" value="${drive['track_width']}"/>

  <!-- Neigung (Roll/Pitch, rad) der Sensoren aus der Kalibrierung (calib/mounts.yaml); description.launch.py reicht sie
       als Argumente durch. Ohne Kalibrierung 0 = waagrecht. -->
  <xacro:arg name="livox_roll" default="0.0"/>
  <xacro:arg name="livox_pitch" default="0.0"/>
  <xacro:arg name="camera_roll" default="0.0"/>
  <xacro:arg name="camera_pitch" default="0.0"/>

  <!-- Sensorposition relativ zum Drehpunkt (base_link, Achshöhe), gemessen. -->
  <xacro:property name="lidar_x" value="0.03"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.28"/>
  <xacro:property name="camera_x" value="0.0"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.39"/>

  <!-- Körper: Quader, dessen untere Ecken über den Radmitten (Antriebsräder und Schleppräder) liegen und der unter dem
       Lidar endet. Fahnenmast hinten in der Mitte. Maße der Fahne und des Mastdurchmessers geschätzt. -->
  <xacro:property name="lidar_height" value="0.06"/>
  <xacro:property name="body_bottom" value="0.0"/>                          <!-- Achshöhe -->
  <xacro:property name="body_top" value="${lidar_z - lidar_height / 2.0}"/> <!-- Unterseite des Lidars -->
  <xacro:property name="mast_length" value="0.40"/>
  <xacro:property name="mast_radius" value="0.01"/>

  <!-- Nur fürs Aussehen in RViz (nicht gemessen): Radbreite, Schleppräder -->
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="caster_x" value="-0.34"/>              <!-- 34 cm hinter der Antriebsachse -->
  <xacro:property name="caster_y" value="${track / 2.0}"/>     <!-- Annahme: gleiche Spur wie vorne -->
  <xacro:property name="caster_radius" value="${wheel_radius}"/>   <!-- Annahme: Roboter steht waagrecht -->

  <link name="base_footprint"/>

  <link name="base_link"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Antriebsräder. Gelenkwinkel (positiv = Rad rollt vorwärts) sendet diff_drive_node auf /joint_states. -->
  <xacro:macro name="drive_wheel" params="name joint side_y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
    </link>
    <joint name="${joint}" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="0 ${side_y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel name="left_wheel" joint="${drive['left_joint']}" side_y="${track / 2.0}"/>
  <xacro:drive_wheel name="right_wheel" joint="${drive['right_joint']}" side_y="${-track / 2.0}"/>

  <!-- Frei schwenkende Schleppräder: für die Kinematik egal, hier fest montiert -->
  <xacro:macro name="caster" params="name side_y">
    <link name="${name}">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="caster"><color rgba="0.3 0.3 0.3 1"/></material>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${caster_x} ${side_y} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:caster name="caster_left" side_y="${caster_y}"/>
  <xacro:caster name="caster_right" side_y="${-caster_y}"/>

  <link name="body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${-caster_x} ${track} ${body_top - body_bottom}"/></geometry>
      <material name="body"><color rgba="0.75 0.75 0.78 1"/></material>
    </visual>
  </link>
  <joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body"/>
    <origin xyz="${caster_x / 2.0} 0 ${(body_top + body_bottom) / 2.0}" rpy="0 0 0"/>
  </joint>

  <!-- Fahnenmast: steht hinten in der Mitte auf dem Körper -->
  <link name="flag_pole">
    <visual>
      <geometry><cylinder radius="${mast_radius}" length="${mast_length}"/></geometry>
      <material name="pole"><color rgba="0.9 0.9 0.9 1"/></material>
    </visual>
  </link>
  <joint name="flag_pole_joint" type="fixed">
    <parent link="body"/>
    <child link="flag_pole"/>
    <origin xyz="${caster_x / 2.0} 0 ${(body_top - body_bottom) / 2.0 + mast_length / 2.0}" rpy="0 0 0"/>
  </joint>

  <!-- Rote dreieckige Fahne am oberen Mastende, Spitze zeigt nach hinten (-x). Netz: meshes/flag.stl,
       Ursprung = Mastachse oben, die Fahne hängt 12 cm nach unten und ist 20 cm lang. -->
  <link name="flag">
    <visual>
      <geometry><mesh filename="package://slop_description/meshes/flag.stl"/></geometry>
      <material name="flag"><color rgba="0.85 0.05 0.05 1"/></material>
    </visual>
  </link>
  <joint name="flag_joint" type="fixed">
    <parent link="flag_pole"/>
    <child link="flag"/>
    <origin xyz="0 0 ${mast_length / 2.0}" rpy="0 0 0"/>
  </joint>

  <!-- Livox Mid-360s: Frame wie im Treiber (slop_sensors lidar.launch.py: frame_id), schaut geradeaus (+x) -->
  <link name="livox_frame">
    <visual>
      <geometry><cylinder radius="0.0325" length="${lidar_height}"/></geometry>
      <material name="lidar"><color rgba="0.8 0.4 0.1 1"/></material>
    </visual>
  </link>
  <joint name="livox_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="$(arg livox_roll) $(arg livox_pitch) 0"/>
  </joint>

  <!-- RealSense D435i: camera_link wie im Treiber (camera_name camera), schaut geradeaus (+x) -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.025 0.09 0.025"/></geometry>
      <material name="camera"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="$(arg camera_roll) $(arg camera_pitch) 0"/>
  </joint>

</robot>
